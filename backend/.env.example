NODE_ENV=development
HOST=127.0.0.1
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=debug
# Optional comma-separated IPv4/IPv6 DNS server IPs for this Node process.
# Blank/omitted preserves the system resolver. Applied before MongoDB SRV/TXT lookups.
# DNS_SERVERS=8.8.8.8,8.8.4.4
DNS_SERVERS=
# Preserve existing .env values. Replace this placeholder with the actual Atlas URI.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER/YOUR_DATABASE
# Generate 32 random bytes encoded as 64 hexadecimal characters. Never commit the real key.
JWT_SECRET=
JWT_ISSUER=flowwork-ai
JWT_AUDIENCE=flowwork-web
ACCESS_TOKEN_MINUTES=10
REFRESH_IDLE_DAYS=7
REFRESH_ABSOLUTE_DAYS=30
# Capture stores sensitive links in ignored .mail-capture/, never responses or logs.
# Production requires smtp and real provider configuration.
MAIL_MODE=capture
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=

# Phase 5: no new secret or mandatory environment variable is needed.
# After private credential rotation, explicitly initialize additive tenant schema:
# npm.cmd run schema:tenants -- --rotation-confirmed
# Normal dev/start require declared tenant indexes; tests provision isolated databases only.
